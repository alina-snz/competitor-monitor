rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own settings
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Sites — only owner can read/write their sites
    match /sites/{siteId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Changes — only owner can read their history
    match /changes/{changeId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Telegram connections — any logged in user can read/write
    // needed so frontend can listen for bot connection via token
    match /telegram_connections/{token} {
      allow read, write: if request.auth != null;
    }

    // Backend-only collections — no frontend access
    match /selectors/{doc} { allow read, write: if false; }
    match /snapshots/{doc} { allow read, write: if false; }
    match /hashes/{doc} { allow read, write: if false; }
  }
}